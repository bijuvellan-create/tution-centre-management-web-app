# ===================================================================
# Smart Tuition Manager - Backend environment variables
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real .env file to Git.
# ===================================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Replace <user>, <password> and <cluster> with your Atlas values.
# The database name at the end (smart_tuition) is created automatically.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_tuition?retryWrites=true&w=majority

# Authentication
# Generate a long random secret (at least 32 characters).
# Tip: run  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
# Short-lived access token (recommended: 15m - 1h)
JWT_EXPIRES_IN=30m

# CORS: the URL where your React frontend runs
FRONTEND_URL=http://localhost:5173

# Branding (configurable application name)
APP_NAME=Smart Tuition Manager

# Timezone used for date-based reports (IANA name)
TZ=Asia/Kolkata

# -------------------------------------------------------------------
# One-time administrator bootstrap (used by "npm run seed:admin").
# The script only runs when NO administrator account exists yet.
# Leave these EMPTY and you will be prompted interactively instead,
# which is safer because secrets are never written to disk.
# -------------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
